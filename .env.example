# Copie este archivo como .env y ajuste los valores. El archivo .env NO se sube
# al repositorio (está en .gitignore) porque contiene secretos.
# Importante: escriba los comentarios en líneas propias, nunca al final de un valor.

# --- Aplicación ---------------------------------------------------------------
# Entorno: desarrollo | produccion
APP_ENTORNO=desarrollo
APP_PUERTO=8080
APP_ZONA_HORARIA=America/Bogota
# Puerto del equipo anfitrión donde Nginx expone la API.
NGINX_PUERTO=8080
# Orígenes desde los que un frontend en el navegador puede llamar a la API,
# separados por comas (ej. http://localhost:5173). Vacío = ninguno; Postman y
# curl no los necesitan. * = cualquier origen (solo para pruebas).
CORS_ORIGENES=

# --- PostgreSQL -----------------------------------------------------------------
POSTGRES_USER=seguimiento
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=seguimiento
# docker-compose sobrescribe el host con "postgres". Use localhost si ejecuta la API fuera de Docker.
POSTGRES_HOST=localhost
POSTGRES_PUERTO=5432
# Opcional: si se define, tiene prioridad sobre las variables anteriores.
# DATABASE_URL=postgres://usuario:clave@host:5432/bd?sslmode=disable

# --- Redis (cola de tareas Asynq) --------------------------------------------------
# docker-compose la sobrescribe con "redis:6379".
REDIS_DIRECCION=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Autenticación ----------------------------------------------------------------
# Mínimo 32 caracteres. Genere uno con: openssl rand -base64 48
JWT_SECRETO=reemplace-este-valor-por-un-secreto-aleatorio-largo
JWT_EXPIRACION=8h

# Administrador inicial: se crea al arrancar la API si aún no existe.
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@uniandes.edu.co
ADMIN_PASSWORD=cambie-esta-clave

# --- Archivos ------------------------------------------------------------------------
# Dónde se guardan los PDF y los adjuntos. local = una carpeta (en Docker, el
# volumen compartido entre la API y el worker). En la Entrega 2 se agrega Cloud Storage.
ALMACENAMIENTO_TIPO=local
# Carpeta del almacenamiento local.
ALMACENAMIENTO_RUTA=/data
# Tamaño máximo de cada adjunto en MB (una tarea admite hasta 5 adjuntos).
# Si lo aumenta, ajuste client_max_body_size en nginx/nginx.conf (5 x este valor + 1).
ADJUNTO_MAX_MB=10

# --- Generación de reportes (worker) ------------------------------------------------
# Reportes que se generan en paralelo.
WORKER_CONCURRENCIA=2
# Reintentos ante errores transitorios del modelo (límite de uso, caídas).
REPORTE_MAX_REINTENTOS=3
# Tiempo máximo por reporte.
REPORTE_TIMEOUT=5m

# --- Modelo de IA ---------------------------------------------------------------------
# LLM_PROVEEDOR puede ser:
#   simulado  -> no llama a ningún modelo (para desarrollar y probar sin credenciales)
LLM_PROVEEDOR=simulado
LLM_URL_BASE=
LLM_API_KEY=
LLM_MODELO=
# Opcionales: déjelos vacíos para usar el valor por defecto del proveedor.
LLM_MAX_TOKENS=
LLM_TEMPERATURA=
LLM_TIMEOUT=2m
